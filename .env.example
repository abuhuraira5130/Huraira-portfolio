# ============================================================
#  Abu Huraira Portfolio — Environment Variables
#  Copy this file to ".env.local" for local development, and
#  add the SAME variables in Vercel (Project > Settings >
#  Environment Variables) for production.
#
#  >>> FILL IN THE BLANK (SENSITIVE) FIELDS YOURSELF <<<
#  Never commit your real .env.local to GitHub.
# ============================================================

# --- Email (Gmail SMTP — same settings as the old Django backend) ---

# SMTP server (leave as-is for Gmail)
EMAIL_HOST=smtp.gmail.com

# SMTP port (leave as-is for Gmail STARTTLS)
EMAIL_PORT=587

# Use TLS (leave as-is for Gmail)
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# [SENSITIVE — FILL THIS IN] Your Gmail address, e.g. you@gmail.com
# This is the account the emails are sent FROM.
EMAIL_HOST_USER=

# [SENSITIVE — FILL THIS IN] Gmail App Password (NOT your normal Gmail password)
# How to get one: Google Account > Security > 2-Step Verification must be ON
# > App passwords > create one for "Mail" > paste the 16-character code here.
EMAIL_HOST_PASSWORD=

# [FILL THIS IN — optional] Email shown as the sender.
# If left blank, EMAIL_HOST_USER is used (same behaviour as the old Django code).
DEFAULT_FROM_EMAIL=

# [FILL THIS IN — optional] Email address that RECEIVES contact-form submissions.
# If left blank, submissions go to EMAIL_HOST_USER
# (same behaviour as the old Django code: CONTACT_RECIPIENT_EMAIL defaulted to EMAIL_HOST_USER).
CONTACT_RECIPIENT_EMAIL=
